    padding:40px;
}

.contenedor{
    display:flex;
    justify-content:center;
    gap:30px;
    flex-wrap:wrap;
}

.card{
    width:220px;
    background:#30ec40;
    border-radius:15px;
    padding:15px;
    text-align:center;

    opacity:0;
    transform:translateY(30px);

    transition:0.6s;
}

.card img{
    width:100%;
    height:120px;
    object-fit:cover;
    border-radius:10px;
}

.card.mostrar{
    opacity:1;
    transform:translateY(0);
}

header{
    width:100%;
    display:flex;
    justify-content:center;
    margin-bottom:40px;
}

h1{
    font-family:"Luckiest Guy", sans-serif;
    font-size:100px;
     color: #4f0764;
            text-shadow:
            2px 2px 0 #8c39b3,
             4px 4px 0 #4a0d63,
             6px 6px 0 #5a076e,
             8px 8px 10px rgba(0, 0, 0, 0.5);
}

button {
    background-color: #1c8b1c; /* Color de fondo */
    color: white;              /* Color del texto */
    border: none;              /* Quita el borde */
    padding: 10px 20px;        /* Tamaño del botón */
    border-radius: 10px;       /* Esquinas redondeadas */
    cursor: pointer;           /* Cambia el cursor */}

.oculto{

    opacity:0;

    transition:0.5s;

}



        

        @keyframes latido{

            0%{

                transform:scale(1);

            }

            50%{

                transform:scale(1.08);

            }

            100%{

                transform:scale(1);

            }

        }




    </style>

</head>

